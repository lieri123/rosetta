# Copy to /etc/rosetta/env and chmod 600.
#
# The provider defaults to "mock", which reads nothing and costs nothing. Set
# it to google or azure only when you mean to send pages to them.

ROSETTA_PROVIDER=mock

# GOOGLE_VISION_API_KEY=
# AZURE_VISION_ENDPOINT=https://your-resource.cognitiveservices.azure.com
# AZURE_VISION_KEY=

ROSETTA_WORKERS=4
